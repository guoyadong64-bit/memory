# Additive settings; existing LLM/Jev credentials stay in .env.
# Optional vision model for FindingDory structured extraction; blank uses MEMORY_LLM_MODEL.
# Uses the same MEMORY_LLM_BASE_URL and API key; must accept image_url + JSON output.
MEMORY_VISION_MODEL=
# Qwen requests explicitly disable thinking by default for stable JSON and bounded output.
MEMORY_LLM_ENABLE_THINKING=false
MEMORY_RETRIEVAL_STRATEGY=hypergraph
MEMORY_SEMANTIC_MIN_SIMILARITY=0.05
# Optional OpenAI-compatible embeddings service. Blank model => offline TF-IDF.
# In mock mode embedding requests are always disabled.
MEMORY_EMBEDDING_MODEL=
# Empty URL/key reuse MEMORY_LLM_BASE_URL / MEMORY_LLM_API_KEY in live mode.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
